# Conexão MySQL (driver assíncrono asyncmy)
DATABASE_URL=mysql+asyncmy://jenpex_user:change-me@localhost:3306/jenpex
# "on" para bancos na nuvem (Aiven). Local: off
DATABASE_SSL=off
# Conteúdo PEM do CA do provedor (opcional; no Aiven baixe o "CA certificate")
DATABASE_CA_CERT=

# Segredo dos tokens. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Administrador criado/atualizado automaticamente ao iniciar (senha >= 12 caracteres)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-longa

# Só necessário se o frontend rodar em outro domínio. Em produção (mesma URL) deixe vazio.
CORS_ORIGINS=http://localhost:5173
